# Settings for scripts/dev_shop.py (local click-through of the shop, xray faked).
# Copy to dev/dev.env (git-ignored) and fill the two values below.
DEV_SHOP=1

# A SEPARATE test bot from @BotFather - never the production token.
BOT_TOKEN=PUT-TEST-BOT-TOKEN-HERE
# Your numeric Telegram id (from @userinfobot). This account sees the admin side;
# use a second Telegram account to act as a customer.
ADMIN_IDS=

DB=dev/dev.db
SUB_DIR=dev/sub
DOMAIN=example.invalid
SUB_BASE_URL=https://example.invalid
IPS=104.16.96.1
POLL_SECONDS=30
ENDPOINTS=[{"proto":"vless","net":"ws","tag":"vless-ws","port":10000,"path":"/dev","label":"VLESS-WS","tls_ports":[443],"notls_ports":[]}]
